# =============================================================================
# Smart Parking System - Docker Environment Configuration
# =============================================================================

# Database Configuration
POSTGRES_DB=smart_parking_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
SPRING_DATASOURCE_URL=jdbc:postgresql://parking-db:5432/smart_parking_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# UPI Payment Configuration
PARKING_UPI_MERCHANT_ID=your-actual-upi-id
PARKING_UPI_MERCHANT_NAME=Smart Parking System

# Security Configuration
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# Rate Limiting Configuration (requests per hour)
RATE_LIMIT_BOOKINGS=30
RATE_LIMIT_LOCKS=50
RATE_LIMIT_GENERAL=300
RATE_LIMIT_RECEIPT=50
RATE_LIMIT_VIEW=200

# JVM Configuration
JAVA_OPTS=-Xms512m -Xmx2g -XX:+UseContainerSupport -XX:MaxRAMPercentage=75
