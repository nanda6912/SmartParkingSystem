# =============================================================================
# Smart Parking System - Docker Environment Configuration Template
# =============================================================================
# Copy this file to .env and update the values with your actual configuration
# =============================================================================

# Database Configuration
DB_NAME=smart_parking_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_PORT=5432

# Spring Boot Configuration
SPRING_PROFILE=prod
SERVER_PORT=8081
ACTUATOR_PORT=8082

# UPI Payment Configuration
UPI_MERCHANT_ID=your-actual-upi-id
UPI_MERCHANT_NAME=Smart Parking System

# Rate Limiting Configuration (requests per hour)
RATE_LIMIT_BOOKINGS=30
RATE_LIMIT_LOCKS=50
RATE_LIMIT_GENERAL=300
RATE_LIMIT_RECEIPT=50
RATE_LIMIT_VIEW=200
